# Local paths for this machine (git-ignored). Weights live on the storage drive; the root drive is nearly full.

# Common
HF_HOME=/media/skr/storage/hf_home
MODEL_ROOT=/media/skr/storage/models/imagewam
OUTPUT_ROOT=./runs
# DATA_ROOT: the LIBERO training data (yuanty/LIBERO-fastwam) is not downloaded; not needed for inference tests.

# FLUX.2 (4B variant only; the 9B weights are not downloaded)
FLUX2_VARIANT=4b
FLUX2_SRC=/home/skr/Downloads/pi_07/ImageWAM/third_party/flux2
FLUX2_MODEL_PATH=/media/skr/storage/models/imagewam/flux2/FLUX.2-klein-base-4B/flux-2-klein-base-4b.safetensors
# Gated: accept the license at https://huggingface.co/black-forest-labs/FLUX.2-dev, then download ae.safetensors here.
FLUX2_AE_MODEL_PATH=/media/skr/storage/models/imagewam/flux2/FLUX.2-dev/ae.safetensors
FLUX2_QWEN3_MODEL_SPEC=Qwen/Qwen3-4B

# Evaluation
CKPT_PATH=/media/skr/storage/models/imagewam/imagewam_release/libero/flux2_klein_4b/model.pt
DATASET_STATS_PATH=/media/skr/storage/models/imagewam/imagewam_release/libero/flux2_klein_4b/dataset_stats.json
