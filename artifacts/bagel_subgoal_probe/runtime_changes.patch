+"""Inference fallback for FlashAttention's packed variable-length interface.
+
+Uses PyTorch SDPA with FlashAttention's bottom-right causal alignment.
+This changes the attention implementation, not the model weights; numerical
+outputs need not be bit-identical to the upstream FlashAttention kernel.
+"""
+import torch
+from torch.nn.functional import scaled_dot_product_attention
+
+
+def flash_attn_varlen_func(q, k, v, cu_seqlens_q, cu_seqlens_k,
+                           max_seqlen_q, max_seqlen_k, causal=False):
+    q_bounds = cu_seqlens_q.tolist()
+    k_bounds = cu_seqlens_k.tolist()
+    if len(q_bounds) != len(k_bounds):
+        raise ValueError("Query and key batches must have equal length")
+    outputs = []
+    for i in range(len(q_bounds) - 1):
+        qi = q[q_bounds[i]:q_bounds[i + 1]].transpose(0, 1).unsqueeze(0)
+        ki = k[k_bounds[i]:k_bounds[i + 1]].transpose(0, 1).unsqueeze(0)
+        vi = v[k_bounds[i]:k_bounds[i + 1]].transpose(0, 1).unsqueeze(0)
+        nq, nk = qi.shape[-2], ki.shape[-2]
+        mask = None
+        same_length_causal = causal and nq == nk
+        if causal and nq != nk:
+            mask = (torch.arange(nk, device=q.device)[None, :]
+                    <= torch.arange(nq, device=q.device)[:, None] + nk - nq)
+        result = scaled_dot_product_attention(
+            qi, ki, vi, attn_mask=mask, is_causal=same_length_causal,
+            dropout_p=0.0, enable_gqa=qi.shape[1] != ki.shape[1],
+        )
+        outputs.append(result.squeeze(0).transpose(0, 1))
+    return torch.cat(outputs, dim=0)
